# Data: never versioned (keep the folder structure only)
data/**
!data/**/
!data/**/.gitkeep
# The annotation guide is part of the method (appendix of the paper).
!data/annotation/GUIDE.md

# Run logs
logs/*
!logs/.gitkeep

# Large binary artefacts
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.ttl
*.h5
*.pkl
*.tar
*.tar.gz
*.zip

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/

# Model and dataset caches
.cache/
hf_cache/
wandb/

# Secrets (OpenReview credentials, API keys)
.env
.env.*

# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc

# Bibliographic exports (Scopus, Consensus): they hold abstracts, which are not ours to redistribute.
# Only the verified entries of paper/references.bib are versioned.
paper/refs/
/export_*.csv

# Editors and OS
.vscode/
.idea/
.DS_Store
.claude/settings.local.json
# Clones of external repositories (their data files are extracted next to them)
data/raw/external/*/repo/

# Predictions and explanations per article: regenerated by the scripts
results/predictions/
